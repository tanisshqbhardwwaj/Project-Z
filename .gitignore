# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local sqlite dev database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/prisma/

# OCR training data (large; not needed in repo)
*.traineddata

# Local installer binaries served from /downloads
/public/downloads/*.apk
/public/downloads/*.exe
/public/downloads/*.msi
# Allow shipping installers with the site (needed for Vercel /downloads)
!/public/downloads/project-z-setup.exe
!/public/downloads/project-z.apk


# playwright
/test-results/
/playwright-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android release signing (never commit real secrets)
keystore.properties
*.keystore
*.jks
