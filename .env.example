# =============================================================================
# LOCAL DEVELOPMENT — copy to .env
# =============================================================================
# Start Postgres (and optional MinIO) with: docker compose up -d
# Credentials below match docker-compose.yml — they are not production secrets.

DATABASE_URL="postgresql://projectz:projectz@localhost:5433/projectz"
# Optional: same as DATABASE_URL locally. On Vercel, set this to the direct
# (non-pooled) URL if the Prisma Postgres console shows both.
DIRECT_URL="postgresql://projectz:projectz@localhost:5433/projectz"

# =============================================================================
# VERCEL / PRODUCTION — Prisma Postgres (Singapore) + Cloudflare R2
# =============================================================================
# 1. Create a Prisma Postgres Free database in ap-southeast-1 (Singapore)
#    https://console.prisma.io
# 2. Copy the PostgreSQL connection string into Vercel as DATABASE_URL
# 3. If a direct/non-pooled URL is shown, set DIRECT_URL as well (else copy DATABASE_URL)
# 4. Deploy — `prisma migrate deploy` runs during the Vercel build
# 5. Keep existing R2 (S3_*) variables as-is
# See TRIAL_DEPLOY.md

# AUTH_URL=https://YOUR-APP.vercel.app
# NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Project Z <onboarding@resend.dev>"

# Beta only — comma-separated emails that skip Resend verification (remove before launch)
# TEST_EMAIL_ALLOWLIST="friend1@gmail.com,friend2@gmail.com"

# Storage (MinIO local / Cloudflare R2 production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="project-z"
S3_PUBLIC_URL=""

# AI — manual = no API key (easiest for trial)
AI_PROVIDER="manual"

GROQ_API_KEY=""
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash-lite"

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
SENTRY_DSN=""
INTERNAL_API_KEY="dev-internal-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Owner / ops console — comma-separated emails that can open /ops
# PLATFORM_ADMIN_EMAILS="you@example.com"
# BILLING_CONTACT="8929232078 / UPI 8929232078@ybl"
