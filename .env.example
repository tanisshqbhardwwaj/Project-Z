# =============================================================================
# LOCAL DEVELOPMENT — copy to .env
# =============================================================================
# Local dev uses SQLite (no Docker Postgres needed).
# Production on Vercel uses Turso — see TRIAL_DEPLOY.md.

DATABASE_URL="file:./dev.db"

# =============================================================================
# VERCEL / PRODUCTION — Turso (free, no Postgres needed)
# =============================================================================
# To use Turso locally (same data as production), uncomment and fill:
# TURSO_DATABASE_URL=libsql://your-db-name-user.turso.io
# TURSO_AUTH_TOKEN=eyJhbG...
# Then restart `npm run dev`. Keep DATABASE_URL for Prisma CLI only:
# DATABASE_URL="file:./dev.db"
#
# AUTH_URL=https://YOUR-APP.vercel.app
# NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Project Z <onboarding@resend.dev>"

# Beta only — comma-separated emails that skip Resend verification (remove before launch)
# TEST_EMAIL_ALLOWLIST="friend1@gmail.com,friend2@gmail.com"

# Storage (MinIO local / Cloudflare R2 production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="project-z"
S3_PUBLIC_URL=""

# AI — manual = no API key (easiest for trial)
AI_PROVIDER="manual"

GROQ_API_KEY=""
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash-lite"

INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
SENTRY_DSN=""
INTERNAL_API_KEY="dev-internal-key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

