# =============================================================================
# LOCAL DEVELOPMENT — copy to .env and adjust values
# =============================================================================
# Do NOT paste this file into Vercel. Production uses Neon + R2 (see TRIAL_DEPLOY.md).

DATABASE_URL="postgresql://projectz:projectz@localhost:5433/projectz?schema=public"

# =============================================================================
# VERCEL / PRODUCTION (set these in Vercel → Settings → Environment Variables)
# =============================================================================
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# AUTH_URL=https://YOUR-APP.vercel.app
# NEXT_PUBLIC_APP_URL=https://YOUR-APP.vercel.app  (must match AUTH_URL exactly)
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (NOT localhost:9000)

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Email (Resend) — optional in dev (logs to console)
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="Project Z <onboarding@resend.dev>"

# Storage (MinIO local / Cloudflare R2 production)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="project-z"
S3_PUBLIC_URL=""

# AI — pick ONE provider (all have a free option)
# manual = no API key, user fills fields (easiest, always works)
# groq   = free AI at https://console.groq.com (recommended)
# gemini = free AI at https://aistudio.google.com/apikey
AI_PROVIDER="groq"

# Groq (free, no credit card) — https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_TEXT_MODEL="llama-3.3-70b-versatile"
# Optional — only if your Groq account has vision models enabled
# GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# Gemini (optional)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash-lite"

# Inngest (recommended for production extraction jobs)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Optional monitoring
SENTRY_DSN=""

# Internal jobs
INTERNAL_API_KEY="dev-internal-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
