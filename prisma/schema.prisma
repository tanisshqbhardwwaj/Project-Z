  updatedAt             DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ShopOfferCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, isActive, startDate, endDate])
}

model ShopSaleReturn {
  id                  String                 @id @default(uuid())
  organizationId      String
  shopSaleId          String
  returnNumber        String
  type                ReturnTransactionType  @default(RETURN)
  /// Value of the goods coming back from the customer.
  returnValuePaise    BigInt                 @default(0)
  /// Value of the replacement goods handed to the customer (exchange only).
  exchangeValuePaise  BigInt                 @default(0)
  /// Extra money the customer paid because the replacement cost more.
  additionalPaidPaise BigInt                 @default(0)
  /// Money (or store credit) given back to the customer.
  refundAmountPaise   BigInt
  refundMethod        PaymentMethod          @default(CASH)
  reason              ReturnReason
  notes               String?
  customerId          String?
  customerName        String?
  customerPhone       String?
  staffId             String?
  staffName           String?
  exchangeSaleId      String?
  createdById         String
  createdAt           DateTime               @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopSale     ShopSale      @relation(fields: [shopSaleId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("ShopReturnCreatedBy", fields: [createdById], references: [id])
  staff        StaffMember?  @relation("ShopReturnStaff", fields: [staffId], references: [id], onDelete: SetNull)
  lines        ShopSaleReturnLine[]

  @@unique([organizationId, returnNumber])
  @@index([organizationId, shopSaleId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, staffId])
}

model ShopSaleReturnLine {
  id              String   @id @default(uuid())
  returnId        String
  lineKey         String
  inventoryItemId String?
  productId       String?
  productName     String
