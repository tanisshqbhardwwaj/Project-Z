  customerName   String?
  customerPhone  String?
  customerGstin  String?
  staffId        String?
  salesBoyName   String?
  totalPaise     BigInt
  gstPaise       BigInt     @default(0)
  paidAmountPaise BigInt    @default(0)
  totalCostPaise BigInt     @default(0)
  paymentStatus  InvoicePaymentStatus @default(PAID)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus @default(COMPLETED)
  issueInvoice   Boolean    @default(false)
  itemsJson      Json
  kotJson        Json?
  notes          String?
  pricingJson    Json         @default("{}")
  orderType      ShopOrderType?
  tableId        String?
  deliveryAddress String?
  channel        SalesChannel @default(DIRECT)
  channelOrderId String?
  channelCommissionPaise BigInt?
  channelPayoutPaise BigInt?
  restaurantOrderId String? @unique
  createdById    String
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       ShopBranch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer     ShopCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff        StaffMember? @relation("ShopSaleStaff", fields: [staffId], references: [id], onDelete: SetNull)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  restaurantOrder RestaurantOrder? @relation(fields: [restaurantOrderId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ShopSaleCreatedBy", fields: [createdById], references: [id])
  creditEntries CustomerCreditEntry[]
  returns      ShopSaleReturn[]
  serviceAppointment ServiceAppointment?
  customerPackages CustomerPackage[]
  deliveries   Delivery[]

  @@index([organizationId, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, paymentStatus])
  @@unique([organizationId, billNumber])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, salesBoyName, createdAt])
  @@index([organizationId, staffId, createdAt])
  @@index([organizationId, channel, createdAt])
  @@index([organizationId, orderType, createdAt])
