  paidAmountPaise BigInt?
  paymentMethod  PaymentMethod?
  shopExpenseId  String?
  notes          String?
  remindedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recurring    ShopRecurringExpense @relation(fields: [recurringId], references: [id], onDelete: Cascade)

  @@unique([recurringId, periodYear, periodMonth])
  @@index([organizationId, status, dueDate])
