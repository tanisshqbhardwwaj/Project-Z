  contractAmountPaise    BigInt        @default(0)
  budgetAmountPaise      BigInt?
  location               String?
  description            String?
  expectedStartDate      DateTime?
  expectedCompletionDate DateTime?
  completionPercent      Int           @default(0)
  createdById            String
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  workOrder    WorkOrder?
  members      ProjectMember[]
  invites      ProjectInvite[]
  partnerRequests ProjectPartnerRequest[]
  splitConfig  ProjectSplitConfig?
  expenses     Expense[]
  payments     Payment[]
  documents    Document[]
  boqItems         BoqItem[]
  measurementEntries MeasurementEntry[]
  materialIssues   MaterialIssue[]
  designStages     DesignStage[]
  billCounters     ProjectBillCounter[]
  invoices         ProjectInvoice[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
}

model ProjectBillCounter {
  id         String @id @default(uuid())
  projectId  String
  fiscalYear String
  seq        Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, fiscalYear])
}

model ProjectInvoice {
  id             String               @id @default(uuid())
  organizationId String
  projectId      String
  billNumber     String
  clientName     String?
  clientPhone    String?
  clientGstin    String?
  totalPaise     BigInt
  gstPaise       BigInt               @default(0)
  paymentMethod  PaymentMethod        @default(CASH)
  status         ProjectInvoiceStatus @default(ISSUED)
  itemsJson      Json
  pricingJson    Json                 @default("{}")
  notes          String?
  createdById    String
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProjectInvoiceCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, billNumber])
  @@index([organizationId])
  @@index([projectId, createdAt])
}

model ProjectMember {
  id          String    @id @default(uuid())
  projectId   String
  userId      String
  splitType   SplitType @default(EQUAL)
  splitValue  Decimal?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, userId])
}

model ProjectInvite {
  id             String    @id @default(uuid())
  projectId      String
  organizationId String
  email          String?
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("ProjectInviteSentBy", fields: [invitedById], references: [id])
  requests     ProjectPartnerRequest[]

  @@index([projectId])
  @@index([organizationId, email])
}

model ProjectPartnerRequest {
  id             String               @id @default(uuid())
  projectId      String
  organizationId String
  userId         String
  inviteId       String?
  status         PartnerRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation("PartnerRequestUser", fields: [userId], references: [id])
  invite       ProjectInvite? @relation(fields: [inviteId], references: [id])
  reviewedBy   User?          @relation("PartnerRequestReviewer", fields: [reviewedById], references: [id])

  @@unique([projectId, userId])
  @@index([projectId, status])
}

model ProjectSplitConfig {
  id        String    @id @default(uuid())
  projectId String    @unique
  splitType SplitType @default(EQUAL)
  splits    Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id              String        @id @default(uuid())
  organizationId  String
  projectId       String        @unique
  workOrderNumber String
  workOrderDate   DateTime
  clientName      String
  headOfAccount   String?
  timeOfCompletion String?
  paymentTerms    String?
  taxInfo         Json?
  status          ProjectStatus @default(DRAFT)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  documents    Document[]

  @@index([organizationId])
}

model Vendor {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  gstNumber      String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  payments     Payment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Expense {
  id                   String    @id @default(uuid())
  organizationId       String
  projectId            String
  vendorId             String?
  categoryId           String
  amountPaise          BigInt
  paidAmountPaise      BigInt    @default(0)
  outstandingPaise     BigInt    @default(0)
  expenseDate          DateTime
  description          String?
  receiptHash          String?
  createdById          String
  isEdited             Boolean   @default(false)
  editedAt             DateTime?
  editedById           String?
  originalAmountPaise  BigInt?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id])
  createdBy    User                @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  editedBy     User?               @relation("ExpenseEditedBy", fields: [editedById], references: [id])
  allocations  PaymentAllocation[]
  documents    Document[]

  @@index([organizationId])
  @@index([projectId, expenseDate])
  @@index([vendorId])
  @@index([organizationId, deletedAt])
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  projectId         String?
  vendorId          String?
  paidByUserId      String
  recipientUserId   String?
  amountPaise       BigInt
  paymentMethod     PaymentMethod @default(CASH)
  referenceNumber   String?
  paymentDate       DateTime
  paymentType       PaymentType   @default(VENDOR)
  notes             String?
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId], references: [id])
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  paidBy        User                @relation("PaymentPaidBy", fields: [paidByUserId], references: [id])
  recipient     User?               @relation("PaymentReceivedBy", fields: [recipientUserId], references: [id])
  createdBy     User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  allocations   PaymentAllocation[]

  @@index([organizationId])
  @@index([vendorId, paymentDate])
  @@index([projectId])
  @@index([paidByUserId])
  @@index([organizationId, deletedAt])
}

model PaymentAllocation {
  id          String @id @default(uuid())
  paymentId   String
  expenseId   String
  amountPaise BigInt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([expenseId])
}

model Document {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  expenseId      String?
  workOrderId    String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  fileHash       String?
  documentType   DocumentType @default(OTHER)
  uploadedById   String
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id])
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  uploadedBy   User          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  extraction   AIExtraction?

  @@index([organizationId])
  @@index([projectId])
  @@index([expenseId])
}

model AIExtraction {
  id              String           @id @default(uuid())
  documentId      String           @unique
  provider        String
  model           String
  status          ExtractionStatus @default(PENDING)
  rawResponse     Json?
  extractedFields Json             @default("[]")
  userCorrections Json?
  errorMessage    String?
  extractedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
  @@index([userId, organizationId, readAt])
  @@index([userId, organizationId, createdAt(sort: Desc)])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}

model ServiceAppointment {
  id                 String            @id @default(uuid())
  organizationId     String
  branchId           String?
  customerId         String?
  customerName       String?
  customerPhone      String?
  staffId            String?
  itemsJson          Json              @default("[]")
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus @default(BOOKED)
  notes              String?
  source             String?
  customerPackageId  String?
  saleId             String?           @unique
  reminderSentAt     DateTime?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          ShopBranch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer        ShopCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  staff           StaffMember?    @relation("ServiceAppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: SetNull)
  sale            ShopSale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdBy       User            @relation("ServiceAppointmentCreatedBy", fields: [createdById], references: [id])
  contractVisits  ServiceContractVisit[]
  followUps       ServiceFollowUp[]
  deliveries      Delivery[]

  @@index([organizationId, startAt])
  @@index([organizationId, staffId, startAt])
  @@index([organizationId, status, startAt])
  @@index([organizationId, customerId])
}

model ServicePackage {
  id                    String             @id @default(uuid())
  organizationId        String
  name                  String
  type                  ServicePackageType
  pricePaise            BigInt
  sessionCount          Int?
  prepaidValuePaise     BigInt?
  validityDays          Int?
  includedServiceIdsJson Json              @default("[]")
  isActive              Boolean            @default(true)
  createdById           String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("ServicePackageCreatedBy", fields: [createdById], references: [id])
  customerPackages CustomerPackage[]

  @@index([organizationId, isActive])
}

model CustomerPackage {
  id                  String        @id @default(uuid())
  organizationId      String
  customerId          String
  packageId           String
  saleId              String?
  purchasedAt         DateTime      @default(now())
  expiresAt           DateTime?
  remainingSessions   Int?
  remainingValuePaise BigInt?
  status              PackageStatus @default(ACTIVE)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     ShopCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package      ServicePackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  sale         ShopSale?         @relation(fields: [saleId], references: [id], onDelete: SetNull)
  appointments ServiceAppointment[]

  @@index([organizationId, customerId, status])
  @@index([organizationId, packageId])
}

model ServiceContract {
  id                 String               @id @default(uuid())
  organizationId     String
  customerId         String
  name               String
  serviceIdsJson     Json                 @default("[]")
  startDate          DateTime
  endDate            DateTime
  billingCycle       ContractBillingCycle @default(YEARLY)
  amountPaise        BigInt
  visitsIncluded     Int?
  nextServiceDate    DateTime?
  reminderDaysBefore Int                  @default(7)
  status             ContractStatus       @default(ACTIVE)
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     ShopCustomer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy    User                   @relation("ServiceContractCreatedBy", fields: [createdById], references: [id])
  visits       ServiceContractVisit[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, nextServiceDate])
}

model ServiceContractVisit {
  id             String              @id @default(uuid())
  organizationId String
  contractId     String
  dueDate        DateTime
  status         ContractVisitStatus @default(SCHEDULED)
  appointmentId  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contract     ServiceContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  appointment  ServiceAppointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueDate])
  @@index([contractId, dueDate])
}

model ServiceFollowUp {
  id             String         @id @default(uuid())
  organizationId String
  customerId     String
  appointmentId  String?
  dueDate        DateTime
  note           String?
  status         FollowUpStatus @default(PENDING)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     ShopCustomer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment  ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("ServiceFollowUpCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, dueDate, status])
  @@index([organizationId, customerId])
}

model Delivery {
  id               String         @id @default(uuid())
  organizationId   String
  branchId         String?
  saleId           String?
  appointmentId    String?
  customerName     String
  customerPhone    String?
  address          String
  assignedStaffId  String?
  status           DeliveryStatus @default(PENDING)
  scheduledAt      DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        ShopBranch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sale          ShopSale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  appointment   ServiceAppointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  assignedStaff StaffMember?        @relation("DeliveryStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdBy     User                @relation("DeliveryCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, assignedStaffId, status])
}

model RestaurantTable {
  id             String                @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  area           String?
  seats          Int                   @default(4)
  status         RestaurantTableStatus @default(FREE)
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       ShopBranch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       RestaurantOrder[]
  sales        ShopSale[]

  @@unique([organizationId, branchId, name])
  @@index([organizationId, branchId, status])
}

model RestaurantOrder {
  id                    String                @id @default(uuid())
  organizationId        String
  branchId              String
  tableId               String?
  customerId            String?
  customerName          String?
  customerPhone         String?
  waiterId              String?
  orderType             ShopOrderType         @default(DINE_IN)
  deliveryAddress       String?
  channel               SalesChannel          @default(DIRECT)
  channelOrderId        String?
  channelCommissionPaise BigInt?
  status                RestaurantOrderStatus @default(OPEN)
  itemsJson             Json                  @default("[]")
  notes                 String?
  createdById           String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       ShopBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer     ShopCustomer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  waiter       StaffMember?    @relation("RestaurantOrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  createdBy    User            @relation("RestaurantOrderCreatedBy", fields: [createdById], references: [id])
  kots         RestaurantKot[]
  sale         ShopSale?

  @@index([organizationId, branchId, status])
  @@index([organizationId, tableId, status])
  @@index([organizationId, channel, createdAt])
}

model RestaurantKot {
  id             String    @id @default(uuid())
  organizationId String
  orderId        String
  roundNumber    Int       @default(1)
  status         KotStatus @default(NEW)
  itemsJson      Json      @default("[]")
  kotJson        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([orderId, roundNumber])
}

model AggregatorPayout {
  id               String                 @id @default(uuid())
  organizationId   String
  channel          SalesChannel
  periodStart      DateTime
  periodEnd        DateTime
  grossPaise       BigInt
  commissionPaise  BigInt                 @default(0)
  taxesPaise       BigInt                 @default(0)
  netPayoutPaise   BigInt
  status           AggregatorPayoutStatus @default(PENDING)
  notes            String?
  createdById      String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("AggregatorPayoutCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, channel, periodStart])
}
