generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PartnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Locale {
  en
  hi
  en_hi
}

enum OrgRole {
  OWNER
  PARTNER
  ACCOUNTANT
  VIEWER
  CASHIER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectInvoiceStatus {
  ISSUED
  CANCELLED
}

enum SplitType {
  EQUAL
  PERCENT
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  CARD
  CHEQUE
  CREDIT
  OTHER
}

enum PaymentType {
  VENDOR
  SETTLEMENT
  OTHER
}

enum DocumentType {
  WORK_ORDER
  RECEIPT
  INVOICE
  OTHER
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
  REVIEWED
}

enum BusinessType {
  CONTRACTOR
  ARCHITECT
  SHOPKEEPER
  SERVICE
}

enum ShopSector {
  GROCERY
  HARDWARE
  ELECTRONICS
  CLOTHING
  PHARMACY
  RESTAURANT
  GENERAL
  FOOTWEAR
  COSMETICS
  FURNITURE
  STATIONERY
  JEWELLERY
  SERVICES
  OTHER
}

enum BillingPlan {
  BASIC
  BUSINESS
  PROFESSIONAL
  BUSINESS_PRO
}

enum SubscriptionStatus {
  TRIAL
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SetupFeeStatus {
  UNPAID
  PAID
  WAIVED
}

enum PlanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingEventType {
  PLAN_ACTIVATED
  PLAN_CHANGED
  PLAN_REQUEST
  REQUEST_REJECTED
  CANCELLED
  REACTIVATED
  SETUP_FEE_WAIVED
  SETUP_FEE_PAID
}

enum SyncOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeviceType {
  WINDOWS
  ANDROID
  IOS
  MAC
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum StaffStatus {
  ACTIVE
  LEFT
}

enum StaffCommissionType {
  NONE
  PERCENT
  FIXED_PER_SALE
  FIXED_PER_ITEM
  FIXED_MONTHLY
}

enum RecurringOccurrenceStatus {
  UPCOMING
  PENDING
  PAID
  SKIPPED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
}

enum AttendanceCheckMethod {
  MANUAL
  QUICK_CHECKIN
  PIN
  QR
  DEVICE
  GEO
  BARCODE
}

enum StaffAttendanceEventType {
  CHECK_IN
  CHECK_OUT
  CORRECTION
}

enum StaffAttendanceEventSource {
  BARCODE
  MANUAL
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollLineType {
  EARNING
  DEDUCTION
}

enum AdvanceStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum ShopItemKind {
  PRODUCT
  SERVICE
  MENU_ITEM
}

enum InvoicePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PurchasePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PurchaseRecordStatus {
  ACTIVE
  CANCELLED
}

enum ShopExpenseType {
  DAILY
  MONTHLY
  ONE_TIME
}

enum CashCountType {
  OPENING
  CLOSING
}

enum CreditTransactionType {
  OPENING
  SALE
  PAYMENT
  ADJUSTMENT
  RETURN_REFUND
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_PRODUCT
  CUSTOMER_CHANGED_MIND
  OTHER
}

enum ReturnTransactionType {
  RETURN
  EXCHANGE
}

enum HeldBillStatus {
  ACTIVE
  RESUMED
  CANCELLED
  EXPIRED
}

enum OfferDiscountType {
  PERCENT
  FIXED_AMOUNT
  PRODUCT_PERCENT
  PRODUCT_FIXED
  CATEGORY_PERCENT
  CATEGORY_FIXED
  BUY_X_GET_Y
  BUY_X_GET_X
  CART_MIN_FLAT
}

enum DesignStageStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ServicePackageType {
  SESSION_PACK
  PREPAID_VALUE
  MEMBERSHIP
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  CANCELLED
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum ContractBillingCycle {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

enum FollowUpStatus {
  PENDING
  DONE
  DISMISSED
}

enum ContractVisitStatus {
  SCHEDULED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum RestaurantTableStatus {
  FREE
  OCCUPIED
  RESERVED
  BILLED
}

enum RestaurantOrderStatus {
  OPEN
  BILLED
  SETTLED
  CANCELLED
}

enum KotStatus {
  NEW
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum ShopOrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum SalesChannel {
  DIRECT
  SWIGGY
  ZOMATO
  OTHER_AGGREGATOR
}

enum AggregatorPayoutStatus {
  PENDING
  MATCHED
  DISCREPANCY
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  name            String
  phone           String?
  emailVerifiedAt DateTime?
  locale          Locale    @default(en)
  lastLoginAt     DateTime?
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  projectsCreated     Project[]            @relation("ProjectCreatedBy")
  workOrdersCreated   WorkOrder[]          @relation("WorkOrderCreatedBy")
  expensesCreated     Expense[]            @relation("ExpenseCreatedBy")
  expensesEdited      Expense[]            @relation("ExpenseEditedBy")
  paymentsCreated     Payment[]            @relation("PaymentCreatedBy")
  paymentsPaid        Payment[]            @relation("PaymentPaidBy")
  paymentsReceived    Payment[]            @relation("PaymentReceivedBy")
  documentsUploaded   Document[]           @relation("DocumentUploadedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]
  invitesSent         OrganizationInvite[] @relation("InviteSentBy")
  projectInvitesSent  ProjectInvite[]      @relation("ProjectInviteSentBy")
  partnerRequests     ProjectPartnerRequest[] @relation("PartnerRequestUser")
  partnerReviews      ProjectPartnerRequest[] @relation("PartnerRequestReviewer")
  betaTestEmailsAdded BetaTestEmail[]         @relation("BetaTestEmailAddedBy")
  staffCreated        StaffMember[]           @relation("StaffCreatedBy")
  staffLinked         StaffMember[]           @relation("StaffUserLink")
  attendanceMarked    StaffAttendance[]       @relation("AttendanceMarkedBy")
  attendanceEventsCreated StaffAttendanceEvent[] @relation("StaffAttendanceEventCreatedBy")
  payrollCreated      StaffPayroll[]          @relation("PayrollCreatedBy")
  payrollUpdated      StaffPayroll[]          @relation("PayrollUpdatedBy")
  staffWagesCreated   StaffWage[]             @relation("StaffWageCreatedBy")
  staffAdvancesCreated StaffAdvance[]         @relation("StaffAdvanceCreatedBy")
  shopSalesCreated    ShopSale[]              @relation("ShopSaleCreatedBy")
  shopHeldBillsCreated ShopHeldBill[]         @relation("ShopHeldBillCreatedBy")
  shopOffersCreated   ShopOffer[]             @relation("ShopOfferCreatedBy")
  shopReturnsCreated  ShopSaleReturn[]        @relation("ShopReturnCreatedBy")
  shopPurchasesCreated ShopPurchase[]         @relation("ShopPurchaseCreatedBy")
  shopPurchasePaymentsCreated ShopPurchasePayment[] @relation("ShopPurchasePaymentCreatedBy")
  shopProductsCreated ShopProduct[]           @relation("ShopProductCreatedBy")
  shopExpensesCreated ShopExpense[]           @relation("ShopExpenseCreatedBy")
  shopCashCountsCreated ShopCashCount[]       @relation("ShopCashCountCreatedBy")
  shopRecurringExpensesCreated ShopRecurringExpense[] @relation("ShopRecurringExpenseCreatedBy")
  serviceAppointmentsCreated ServiceAppointment[] @relation("ServiceAppointmentCreatedBy")
  servicePackagesCreated ServicePackage[] @relation("ServicePackageCreatedBy")
  serviceContractsCreated ServiceContract[] @relation("ServiceContractCreatedBy")
  serviceFollowUpsCreated ServiceFollowUp[] @relation("ServiceFollowUpCreatedBy")
  deliveriesCreated Delivery[] @relation("DeliveryCreatedBy")
  restaurantOrdersCreated RestaurantOrder[] @relation("RestaurantOrderCreatedBy")
  aggregatorPayoutsCreated AggregatorPayout[] @relation("AggregatorPayoutCreatedBy")
  creditEntriesCreated CustomerCreditEntry[]  @relation("CreditEntryCreatedBy")
  measurementsCreated MeasurementEntry[]      @relation("MeasurementCreatedBy")
  materialIssuesCreated MaterialIssue[]     @relation("MaterialIssueCreatedBy")
  projectInvoicesCreated ProjectInvoice[]   @relation("ProjectInvoiceCreatedBy")
  drawingRevisionsCreated DrawingRevision[] @relation("DrawingRevisionCreatedBy")
  planRequestsCreated PlanRequest[]           @relation("PlanRequestCreatedBy")
  planRequestsReviewed PlanRequest[]          @relation("PlanRequestReviewedBy")
  billingEventsActed  BillingEvent[]          @relation("BillingEventActor")
}

model BetaTestEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  addedById String
  createdAt DateTime @default(now())

  addedBy User @relation("BetaTestEmailAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Organization {
  id                    String       @id @default(uuid())
  name                  String
  slug                  String       @unique
  businessType          BusinessType @default(CONTRACTOR)
  shopSector            ShopSector?
  enableStaff           Boolean      @default(false)
  timezone              String       @default("Asia/Kolkata")
  defaultCompletionDays Int          @default(30)
  currency              String       @default("INR")
  settings              Json               @default("{}")
  plan                  BillingPlan        @default(BASIC)
  subscriptionStatus    SubscriptionStatus @default(ACTIVE)
  storageQuotaBytes     BigInt             @default(2147483648)
  storageUsedBytes      BigInt             @default(0)
  billingCycle          BillingCycle       @default(MONTHLY)
  currentPeriodEnd      DateTime?
  accessExpiresAt       DateTime?
  setupFeePaise         BigInt?
  setupFeeStatus        SetupFeeStatus     @default(UNPAID)
  earlyBirdSetup        Boolean            @default(false)
  onboardingCompleteAt  DateTime?
  lastActiveAt          DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  localPinHash          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  members          OrganizationMember[]
  invites          OrganizationInvite[]
  projectInvites   ProjectInvite[]
  partnerRequests  ProjectPartnerRequest[]
  projects         Project[]
  workOrders       WorkOrder[]
  vendors          Vendor[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  payments         Payment[]
  documents        Document[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  staffMembers     StaffMember[]
  staffAttendance  StaffAttendance[]
  staffAttendanceEvents StaffAttendanceEvent[]
  staffPayrolls    StaffPayroll[]
  staffWages       StaffWage[]
  staffAdvances    StaffAdvance[]
  orgHolidays      OrgHoliday[]
  shopSales        ShopSale[]
  shopHeldBills    ShopHeldBill[]
  shopOffers       ShopOffer[]
  shopSaleReturns  ShopSaleReturn[]
  shopCustomers    ShopCustomer[]
  shopSuppliers    ShopSupplier[]
  shopPurchases    ShopPurchase[]
  shopPurchasePayments ShopPurchasePayment[]
  shopExpenseCategories ShopExpenseCategory[]
  shopExpenses     ShopExpense[]
  shopRecurringExpenses ShopRecurringExpense[]
  shopRecurringExpenseOccurrences ShopRecurringExpenseOccurrence[]
  shopProducts     ShopProduct[]
  shopCategories   ShopCategory[]
  inventoryItems   InventoryItem[]
  inventoryStockReservations InventoryStockReservation[]
  customerCredits  CustomerCredit[]
  customerCreditEntries CustomerCreditEntry[]
  boqItems         BoqItem[]
  measurementEntries MeasurementEntry[]
  materialIssues   MaterialIssue[]
  designStages     DesignStage[]
  drawingRevisions DrawingRevision[]
  planRequests     PlanRequest[]
  billingEvents    BillingEvent[]
  orgAddons        OrgAddon[]
  syncOutbox       SyncOutbox[]
  syncMutations    SyncMutation[]
  devices          Device[]
  storageObjects   StorageObject[]
  shopInvoiceDraft ShopInvoiceDraft?
  shopBillCounters ShopBillCounter[]
  shopCashCounts   ShopCashCount[]
  projectInvoices  ProjectInvoice[]
  shopBranches     ShopBranch[]
  serviceAppointments ServiceAppointment[]
  servicePackages  ServicePackage[]
  customerPackages CustomerPackage[]
  serviceContracts ServiceContract[]
  serviceContractVisits ServiceContractVisit[]
  serviceFollowUps ServiceFollowUp[]
  deliveries       Delivery[]
  restaurantTables RestaurantTable[]
  restaurantOrders RestaurantOrder[]
  restaurantKots   RestaurantKot[]
  aggregatorPayouts AggregatorPayout[]
}

model ShopBranch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  address        String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales        ShopSale[]
  heldBills    ShopHeldBill[]
  billCounters ShopBillCounter[]
  customers    ShopCustomer[]
  inventoryItems InventoryItem[]
  serviceAppointments ServiceAppointment[]
  deliveries   Delivery[]
  restaurantTables RestaurantTable[]
  restaurantOrders RestaurantOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model ShopBillCounter {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  fiscalYear     String
  seq            Int          @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         ShopBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([organizationId, branchId, fiscalYear])
}

model PlanRequest {
  id             String            @id @default(uuid())
  organizationId String
  fromPlan       BillingPlan
  toPlan         BillingPlan
  status         PlanRequestStatus @default(PENDING)
  createdById    String
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PlanRequestCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("PlanRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status, createdAt])
}

model BillingEvent {
  id             String           @id @default(uuid())
  organizationId String
  type           BillingEventType
  actorUserId    String?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("BillingEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

model OrgAddon {
  id             String    @id @default(uuid())
  organizationId String
  addonKey       String
  quantity       Int       @default(1)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, addonKey])
  @@index([organizationId])
}

model SyncOutbox {
  id             String           @id @default(uuid())
  organizationId String
  kind           String
  payload        Json
  status         SyncOutboxStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime         @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
}

/** Idempotent client mutations applied from Windows/Android push. */
model SyncMutation {
  id             String   @id
  organizationId String
  deviceId       String?
  kind           String
  entityId       String?
  appliedAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, appliedAt])
  @@index([organizationId, kind])
}

model Device {
  id             String       @id @default(uuid())
  organizationId String
  deviceType     DeviceType
  name           String
  pairingToken   String?      @unique
  pairingExpires DateTime?
  status         DeviceStatus @default(PENDING)
  lastSeenAt     DateTime?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model StorageObject {
  id             String   @id @default(uuid())
  organizationId String
  storageKey     String   @unique
  byteSize       BigInt
  category       String   @default("file")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ShopInvoiceDraft {
  id             String   @id @default(uuid())
  organizationId String   @unique
  draftJson      Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(PARTNER)
  status         MemberStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
  @@index([userId, status])
}

model StaffMember {
  id                 String      @id @default(uuid())
  organizationId     String
  userId             String?
  name               String
  phone              String?
  email              String?
  roleKey            String?
  /** Short code embedded in bill numbers, e.g. 4 → INV-4-26-27-00018 */
  cashierCode        String?
  roleTitle          String
  wagePaise          BigInt?
  wagePeriod         String?
  paymentFrequency   String?
  overtimeRatePaise  BigInt?
  commissionType     StaffCommissionType @default(NONE)
  commissionPercent  Float?
  commissionAmountPaise BigInt?
  /** Owner-set login capabilities for linked cashiers (JSON). */
  accessJson         Json                @default("{}")
  attendancePinHash  String?
  /** Unique staff-attendance barcode (SA- prefix, separate from product barcodes). */
  attendanceBarcode     String?
  attendanceBarcodeSetAt DateTime?
  status             StaffStatus @default(ACTIVE)
  joinedAt           DateTime?
  leftAt             DateTime?
  notes              String?
  createdById        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation("StaffUserLink", fields: [userId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("StaffCreatedBy", fields: [createdById], references: [id])
  attendance   StaffAttendance[]
  attendanceEvents StaffAttendanceEvent[]
  payrolls     StaffPayroll[]
  wageHistory  StaffWage[]
  advances     StaffAdvance[]
  sales        ShopSale[]        @relation("ShopSaleStaff")
  returns      ShopSaleReturn[]  @relation("ShopReturnStaff")
  serviceAppointments ServiceAppointment[] @relation("ServiceAppointmentStaff")
  deliveriesAssigned Delivery[] @relation("DeliveryStaff")
  restaurantOrders RestaurantOrder[] @relation("RestaurantOrderWaiter")

  @@unique([organizationId, userId])
  @@unique([organizationId, cashierCode])
  @@unique([organizationId, attendanceBarcode])
  @@index([organizationId, status])
  @@index([organizationId, attendanceBarcode])
  @@index([userId])
}

model StaffWage {
  id             String   @id @default(uuid())
  organizationId String
  staffId        String
  wagePaise      BigInt
  wagePeriod     String
  overtimeRatePaise BigInt?
  effectiveFrom  DateTime
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("StaffWageCreatedBy", fields: [createdById], references: [id])

  @@index([staffId, effectiveFrom])
}

model StaffAttendance {
  id             String           @id @default(uuid())
  organizationId String
  staffId        String
  date           DateTime
  status         AttendanceStatus @default(PRESENT)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  checkInMethod  AttendanceCheckMethod?
  checkOutMethod AttendanceCheckMethod?
  geoVerified    Boolean?
  geoDistanceMeters Float?
  deviceFingerprint String?
  deviceId       String?
  overtimeHours  Float            @default(0)
  notes          String?
  markedById     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  markedBy     User         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  events       StaffAttendanceEvent[]

  @@unique([staffId, date])
  @@index([organizationId, date])
}

model StaffAttendanceEvent {
  id             String                     @id @default(uuid())
  organizationId String
  staffId        String
  attendanceId   String?
  deviceId       String?
  type           StaffAttendanceEventType
  at             DateTime
  source         StaffAttendanceEventSource @default(BARCODE)
  createdById    String
  previousJson   Json?
  createdAt      DateTime                   @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  attendance   StaffAttendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("StaffAttendanceEventCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, staffId, at])
  @@index([organizationId, at])
}

model StaffAdvance {
  id               String        @id @default(uuid())
  organizationId   String
  staffId          String
  amountPaise      BigInt
  repaidPaise      BigInt        @default(0)
  monthlyDeductionPaise BigInt?
  status           AdvanceStatus @default(OPEN)
  notes            String?
  shopExpenseId    String?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("StaffAdvanceCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, staffId])
}

model StaffPayroll {
  id                  String        @id @default(uuid())
  organizationId      String
  staffId             String
  year                Int
  month               Int
  presentDays         Float         @default(0)
  halfDays            Float         @default(0)
  absentDays          Float         @default(0)
  paidLeaveDays       Float         @default(0)
  workingDays         Float         @default(0)
  overtimeHours       Float         @default(0)
  basePaise           BigInt        @default(0)
  commissionPaise     BigInt        @default(0)
  commissionSalesPaise BigInt       @default(0)
  calculatedPaise     BigInt        @default(0)
  adjustmentPaise     BigInt        @default(0)
  finalAmountPaise    BigInt        @default(0)
  driftCalculatedPaise BigInt?
  status              PayrollStatus @default(DRAFT)
  notes               String?
  paidAt              DateTime?
  expenseId           String?
  paymentId           String?
  shopExpenseId       String?
  createdById         String
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("PayrollUpdatedBy", fields: [updatedById], references: [id])
  lines        StaffPayrollLine[]

  @@unique([staffId, year, month])
  @@index([organizationId, year, month])
}

model StaffPayrollLine {
