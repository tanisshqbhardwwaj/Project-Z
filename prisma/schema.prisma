  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Soft stock holds tied to active held bills until resume, cancel, or expiry.
model InventoryStockReservation {
  id              String   @id @default(uuid())
  organizationId  String
  inventoryItemId String
  quantity        Float
  heldBillId      String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  heldBill      ShopHeldBill  @relation(fields: [heldBillId], references: [id], onDelete: Cascade)

  @@index([organizationId, inventoryItemId])
  @@index([heldBillId])
  @@index([expiresAt])
}

model ShopOffer {
  id                  String            @id @default(uuid())
  organizationId        String
  name                  String
