generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PartnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Locale {
  en
  hi
  en_hi
}

enum OrgRole {
  OWNER
  PARTNER
  ACCOUNTANT
  VIEWER
  CASHIER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum SplitType {
  EQUAL
  PERCENT
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK
  CARD
  CHEQUE
  OTHER
}

enum PaymentType {
  VENDOR
  SETTLEMENT
  OTHER
}

enum DocumentType {
  WORK_ORDER
  RECEIPT
  INVOICE
  OTHER
}

enum ExtractionStatus {
  PENDING
  COMPLETED
  FAILED
  REVIEWED
}

enum BusinessType {
  CONTRACTOR
  ARCHITECT
  BUILDER
  SHOPKEEPER
}

enum ShopSector {
  GROCERY
  HARDWARE
  ELECTRONICS
  CLOTHING
  PHARMACY
  RESTAURANT
  GENERAL
}

enum StaffStatus {
  ACTIVE
  LEFT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollLineType {
  EARNING
  DEDUCTION
}

enum AdvanceStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  COMPLETED
  VOID
}

enum BookingStatus {
  BOOKED
  CANCELLED
  HANDED_OVER
}

enum DesignStageStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
}

enum UnitStatus {
  AVAILABLE
  BOOKED
  SOLD
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String?
  name            String
  phone           String?
  emailVerifiedAt DateTime?
  locale          Locale    @default(en)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  projectsCreated     Project[]            @relation("ProjectCreatedBy")
  workOrdersCreated   WorkOrder[]          @relation("WorkOrderCreatedBy")
  expensesCreated     Expense[]            @relation("ExpenseCreatedBy")
  expensesEdited      Expense[]            @relation("ExpenseEditedBy")
  paymentsCreated     Payment[]            @relation("PaymentCreatedBy")
  paymentsPaid        Payment[]            @relation("PaymentPaidBy")
  paymentsReceived    Payment[]            @relation("PaymentReceivedBy")
  documentsUploaded   Document[]           @relation("DocumentUploadedBy")
  notifications       Notification[]
  auditLogs           AuditLog[]
  invitesSent         OrganizationInvite[] @relation("InviteSentBy")
  projectInvitesSent  ProjectInvite[]      @relation("ProjectInviteSentBy")
  partnerRequests     ProjectPartnerRequest[] @relation("PartnerRequestUser")
  partnerReviews      ProjectPartnerRequest[] @relation("PartnerRequestReviewer")
  betaTestEmailsAdded BetaTestEmail[]         @relation("BetaTestEmailAddedBy")
  staffCreated        StaffMember[]           @relation("StaffCreatedBy")
  staffLinked         StaffMember[]           @relation("StaffUserLink")
  attendanceMarked    StaffAttendance[]       @relation("AttendanceMarkedBy")
  payrollCreated      StaffPayroll[]          @relation("PayrollCreatedBy")
  payrollUpdated      StaffPayroll[]          @relation("PayrollUpdatedBy")
  staffWagesCreated   StaffWage[]             @relation("StaffWageCreatedBy")
  staffAdvancesCreated StaffAdvance[]         @relation("StaffAdvanceCreatedBy")
  shopSalesCreated    ShopSale[]              @relation("ShopSaleCreatedBy")
  measurementsCreated MeasurementEntry[]      @relation("MeasurementCreatedBy")
  materialIssuesCreated MaterialIssue[]     @relation("MaterialIssueCreatedBy")
  drawingRevisionsCreated DrawingRevision[] @relation("DrawingRevisionCreatedBy")
  unitBookingsCreated UnitBooking[]           @relation("UnitBookingCreatedBy")
}

model BetaTestEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  addedById String
  createdAt DateTime @default(now())

  addedBy User @relation("BetaTestEmailAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@index([email])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Organization {
  id                    String       @id @default(uuid())
  name                  String
  slug                  String       @unique
  businessType          BusinessType @default(CONTRACTOR)
  shopSector            ShopSector?
  enableStaff           Boolean      @default(false)
  timezone              String       @default("Asia/Kolkata")
  defaultCompletionDays Int          @default(30)
  currency              String       @default("INR")
  settings              Json         @default("{}")
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  members          OrganizationMember[]
  invites          OrganizationInvite[]
  projectInvites   ProjectInvite[]
  partnerRequests  ProjectPartnerRequest[]
  projects         Project[]
  workOrders       WorkOrder[]
  vendors          Vendor[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  payments         Payment[]
  documents        Document[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  staffMembers     StaffMember[]
  staffAttendance  StaffAttendance[]
  staffPayrolls    StaffPayroll[]
  staffWages       StaffWage[]
  staffAdvances    StaffAdvance[]
  orgHolidays      OrgHoliday[]
  shopSales        ShopSale[]
  inventoryItems   InventoryItem[]
  customerCredits  CustomerCredit[]
  boqItems         BoqItem[]
  measurementEntries MeasurementEntry[]
  materialIssues   MaterialIssue[]
  designStages     DesignStage[]
  drawingRevisions DrawingRevision[]
  builderUnits     BuilderUnit[]
  unitBookings     UnitBooking[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(PARTNER)
  status         MemberStatus @default(ACTIVE)
  invitedAt      DateTime?
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model StaffMember {
  id                 String      @id @default(uuid())
  organizationId     String
  userId             String?
  name               String
  phone              String?
  roleTitle          String
  wagePaise          BigInt?
  wagePeriod         String?
  overtimeRatePaise  BigInt?
  status             StaffStatus @default(ACTIVE)
  joinedAt           DateTime?
  leftAt             DateTime?
  notes              String?
  createdById        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation("StaffUserLink", fields: [userId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("StaffCreatedBy", fields: [createdById], references: [id])
  attendance   StaffAttendance[]
  payrolls     StaffPayroll[]
  wageHistory  StaffWage[]
  advances     StaffAdvance[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
}

model StaffWage {
  id             String   @id @default(uuid())
  organizationId String
  staffId        String
  wagePaise      BigInt
  wagePeriod     String
  overtimeRatePaise BigInt?
  effectiveFrom  DateTime
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("StaffWageCreatedBy", fields: [createdById], references: [id])

  @@index([staffId, effectiveFrom])
}

model StaffAttendance {
  id             String           @id @default(uuid())
  organizationId String
  staffId        String
  date           DateTime
  status         AttendanceStatus @default(PRESENT)
  overtimeHours  Float            @default(0)
  notes          String?
  markedById     String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  markedBy     User         @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([staffId, date])
  @@index([organizationId, date])
}

model StaffAdvance {
  id               String        @id @default(uuid())
  organizationId   String
  staffId          String
  amountPaise      BigInt
  repaidPaise      BigInt        @default(0)
  monthlyDeductionPaise BigInt?
  status           AdvanceStatus @default(OPEN)
  notes            String?
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("StaffAdvanceCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, staffId])
}

model StaffPayroll {
  id                  String        @id @default(uuid())
  organizationId      String
  staffId             String
  year                Int
  month               Int
  presentDays         Float         @default(0)
  halfDays            Float         @default(0)
  absentDays          Float         @default(0)
  paidLeaveDays       Float         @default(0)
  workingDays         Float         @default(0)
  overtimeHours       Float         @default(0)
  calculatedPaise     BigInt        @default(0)
  adjustmentPaise     BigInt        @default(0)
  finalAmountPaise    BigInt        @default(0)
  driftCalculatedPaise BigInt?
  status              PayrollStatus @default(DRAFT)
  notes               String?
  paidAt              DateTime?
  expenseId           String?
  paymentId           String?
  createdById         String
  updatedById         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        StaffMember  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("PayrollUpdatedBy", fields: [updatedById], references: [id])
  lines        StaffPayrollLine[]

  @@unique([staffId, year, month])
  @@index([organizationId, year, month])
}

model StaffPayrollLine {
  id          String          @id @default(uuid())
  payrollId   String
  type        PayrollLineType
  label       String
  amountPaise BigInt
  createdAt   DateTime        @default(now())

  payroll StaffPayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@index([payrollId])
}

model OrgHoliday {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

model ShopSale {
  id             String     @id @default(uuid())
  organizationId String
  billNumber     String?
  customerName   String?
  customerPhone  String?
  customerGstin  String?
  salesBoyName   String?
  totalPaise     BigInt
  gstPaise       BigInt     @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  status         SaleStatus @default(COMPLETED)
  issueInvoice   Boolean    @default(false)
  itemsJson      Json
  notes          String?
  createdById    String
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ShopSaleCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, createdAt])
}

model InventoryItem {
  id             String   @id @default(uuid())
  organizationId String
  sku            String?
  size           String?
  barcode        String?
  name           String
  description    String?
  unit           String   @default("pcs")
  quantity       Float    @default(0)
  reorderLevel   Float    @default(0)
  costPaise      BigInt?
  sellPaise      BigInt?
  expiryDate     DateTime?
  sectorMeta     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, barcode])
  @@index([organizationId, name])
}

model CustomerCredit {
  id             String   @id @default(uuid())
  organizationId String
  customerName   String
  phone          String?
  balancePaise   BigInt   @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerName])
}

model BoqItem {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  itemCode       String?
  description    String
  unit           String
  quantity       Float
  ratePaise      BigInt
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MeasurementEntry {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  boqItemId      String?
  description    String
  quantity       Float
  unit           String
  date           DateTime
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("MeasurementCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, date])
}

model MaterialIssue {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  itemName       String
  quantity       Float
  unit           String
  issuedTo       String?
  date           DateTime
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("MaterialIssueCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, date])
}

model DesignStage {
  id             String            @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  sortOrder      Int               @default(0)
  feePaise       BigInt?
  status         DesignStageStatus @default(PENDING)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions    DrawingRevision[]

  @@index([projectId, sortOrder])
}

model DrawingRevision {
  id             String   @id @default(uuid())
  organizationId String
  stageId        String
  revisionNo     Int
  title          String
  notes          String?
  submittedAt    DateTime?
  approvedAt     DateTime?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stage        DesignStage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DrawingRevisionCreatedBy", fields: [createdById], references: [id])

  @@index([stageId, revisionNo])
}

model BuilderUnit {
  id             String     @id @default(uuid())
  organizationId String
  projectId      String
  unitNumber     String
  floor          String?
  areaSqft       Float?
  pricePaise     BigInt?
  status         UnitStatus @default(AVAILABLE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bookings     UnitBooking[]

  @@unique([projectId, unitNumber])
}

model UnitBooking {
  id             String        @id @default(uuid())
  organizationId String
  projectId      String
  unitId         String
  buyerName      String
  buyerPhone     String?
  bookingPaise   BigInt
  status         BookingStatus @default(BOOKED)
  bookedAt       DateTime      @default(now())
  notes          String?
  createdById    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit         BuilderUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("UnitBookingCreatedBy", fields: [createdById], references: [id])

  @@index([projectId, status])
}

model OrganizationInvite {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole  @default(PARTNER)
  token          String   @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteSentBy", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

model Project {
  id                     String        @id @default(uuid())
  organizationId         String
  name                   String
  nickname               String?
  status                 ProjectStatus @default(DRAFT)
  contractAmountPaise    BigInt        @default(0)
  budgetAmountPaise      BigInt?
  location               String?
  description            String?
  expectedStartDate      DateTime?
  expectedCompletionDate DateTime?
  completionPercent      Int           @default(0)
  createdById            String
  deletedAt              DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User                @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  workOrder    WorkOrder?
  members      ProjectMember[]
  invites      ProjectInvite[]
  partnerRequests ProjectPartnerRequest[]
  splitConfig  ProjectSplitConfig?
  expenses     Expense[]
  payments     Payment[]
  documents    Document[]
  boqItems         BoqItem[]
  measurementEntries MeasurementEntry[]
  materialIssues   MaterialIssue[]
  designStages     DesignStage[]
  builderUnits     BuilderUnit[]
  unitBookings     UnitBooking[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model ProjectMember {
  id          String    @id @default(uuid())
  projectId   String
  userId      String
  splitType   SplitType @default(EQUAL)
  splitValue  Decimal?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId, userId])
}

model ProjectInvite {
  id             String    @id @default(uuid())
  projectId      String
  organizationId String
  email          String?
  token          String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("ProjectInviteSentBy", fields: [invitedById], references: [id])
  requests     ProjectPartnerRequest[]

  @@index([projectId])
  @@index([organizationId, email])
}

model ProjectPartnerRequest {
  id             String               @id @default(uuid())
  projectId      String
  organizationId String
  userId         String
  inviteId       String?
  status         PartnerRequestStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime             @default(now())

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User           @relation("PartnerRequestUser", fields: [userId], references: [id])
  invite       ProjectInvite? @relation(fields: [inviteId], references: [id])
  reviewedBy   User?          @relation("PartnerRequestReviewer", fields: [reviewedById], references: [id])

  @@unique([projectId, userId])
  @@index([projectId, status])
}

model ProjectSplitConfig {
  id        String    @id @default(uuid())
  projectId String    @unique
  splitType SplitType @default(EQUAL)
  splits    Json      @default("[]")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id              String        @id @default(uuid())
  organizationId  String
  projectId       String        @unique
  workOrderNumber String
  workOrderDate   DateTime
  clientName      String
  headOfAccount   String?
  timeOfCompletion String?
  paymentTerms    String?
  taxInfo         Json?
  status          ProjectStatus @default(DRAFT)
  notes           String?
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  documents    Document[]

  @@index([organizationId])
}

model Vendor {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  gstNumber      String?
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  payments     Payment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Expense {
  id                   String    @id @default(uuid())
  organizationId       String
  projectId            String
  vendorId             String?
  categoryId           String
  amountPaise          BigInt
  paidAmountPaise      BigInt    @default(0)
  outstandingPaise     BigInt    @default(0)
  expenseDate          DateTime
  description          String?
  receiptHash          String?
  createdById          String
  isEdited             Boolean   @default(false)
  editedAt             DateTime?
  editedById           String?
  originalAmountPaise  BigInt?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id])
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id])
  createdBy    User                @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  editedBy     User?               @relation("ExpenseEditedBy", fields: [editedById], references: [id])
  allocations  PaymentAllocation[]
  documents    Document[]

  @@index([organizationId])
  @@index([projectId, expenseDate])
  @@index([vendorId])
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  projectId         String?
  vendorId          String?
  paidByUserId      String
  recipientUserId   String?
  amountPaise       BigInt
  paymentMethod     PaymentMethod @default(CASH)
  referenceNumber   String?
  paymentDate       DateTime
  paymentType       PaymentType   @default(VENDOR)
  notes             String?
  createdById       String
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId], references: [id])
  vendor        Vendor?             @relation(fields: [vendorId], references: [id])
  paidBy        User                @relation("PaymentPaidBy", fields: [paidByUserId], references: [id])
  recipient     User?               @relation("PaymentReceivedBy", fields: [recipientUserId], references: [id])
  createdBy     User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  allocations   PaymentAllocation[]

  @@index([organizationId])
  @@index([vendorId, paymentDate])
  @@index([projectId])
  @@index([paidByUserId])
}

model PaymentAllocation {
  id          String @id @default(uuid())
  paymentId   String
  expenseId   String
  amountPaise BigInt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([expenseId])
}

model Document {
  id             String       @id @default(uuid())
  organizationId String
  projectId      String?
  expenseId      String?
  workOrderId    String?
  fileName       String
  mimeType       String
  sizeBytes      Int
  storageKey     String
  fileHash       String?
  documentType   DocumentType @default(OTHER)
  uploadedById   String
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id])
  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id])
  uploadedBy   User          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  extraction   AIExtraction?

  @@index([organizationId])
}

model AIExtraction {
  id              String           @id @default(uuid())
  documentId      String           @unique
  provider        String
  model           String
  status          ExtractionStatus @default(PENDING)
  rawResponse     Json?
  extractedFields Json             @default("[]")
  userCorrections Json?
  errorMessage    String?
  extractedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
}
