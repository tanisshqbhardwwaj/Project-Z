/// Parent product. A product owns one or more InventoryItem variants (each variant
/// is the stock-keeping unit that carries its own barcode, SKU and quantity).
/// Products without variants still get exactly one variant row so that every
/// sale/return/purchase flow keeps pointing at an InventoryItem.
model ShopProduct {
  id              String        @id @default(uuid())
  organizationId  String
  itemKind        ShopItemKind  @default(PRODUCT)
  name            String
  description     String?
  brand           String?
  categoryKey     String?
  subCategoryKey  String?
  unit            String    @default("pcs")
  hasVariants     Boolean   @default(false)
  variantAxis     String?
  supplierName    String?
  batchNo         String?
  attributes      Json      @default("{}")
  notes           String?
  createdById     String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("ShopProductCreatedBy", fields: [createdById], references: [id])
  variants     InventoryItem[]

  @@index([organizationId, name])
  @@index([organizationId, categoryKey])
  @@index([organizationId, deletedAt])
}

model InventoryItem {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  productId      String?
  sku            String?
  size           String?
  color          String?
  variantLabel   String?
  barcode        String?
  name           String
  description    String?
  unit           String   @default("pcs")
  quantity       Float    @default(0)
  reorderLevel   Float    @default(0)
  costPaise      BigInt?
  sellPaise      BigInt?
  supplierName   String?
  batchNo        String?
  expiryDate     DateTime?
  attributes     Json     @default("{}")
  sectorMeta     Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       ShopBranch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product      ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  stockReservations InventoryStockReservation[]

  @@unique([organizationId, branchId, barcode])
  @@index([organizationId, branchId])
  @@index([organizationId, name])
  @@index([organizationId, productId])
  @@index([organizationId, sku])
  @@index([organizationId, barcode])
  @@index([organizationId, updatedAt])
}

