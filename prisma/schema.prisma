model ShopInvoiceDraft {
  id             String   @id @default(uuid())
  organizationId String   @unique
  draftJson      Json
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model PlanRequest {
  id             String            @id @default(uuid())
  organizationId String
  fromPlan       BillingPlan
  toPlan         BillingPlan
  status         PlanRequestStatus @default(PENDING)
  createdById    String
  reviewedById   String?
  reviewedAt     DateTime?
  rejectReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("PlanRequestCreatedBy", fields: [createdById], references: [id])
  reviewedBy   User?        @relation("PlanRequestReviewedBy", fields: [reviewedById], references: [id])

  @@index([organizationId, status])
  @@index([status, createdAt])
}

model BillingEvent {
  id             String           @id @default(uuid())
  organizationId String
  type           BillingEventType
  actorUserId    String?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("BillingEventActor", fields: [actorUserId], references: [id])

  @@index([organizationId, createdAt])
}

model SyncOutbox {
  id             String           @id @default(uuid())
  organizationId String
  kind           String
  payload        Json
  status         SyncOutboxStatus @default(PENDING)
  attempts       Int              @default(0)
  lastError      String?
  createdAt      DateTime         @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
}

model Device {
  id             String       @id @default(uuid())
  organizationId String
  deviceType     DeviceType
  name           String
  pairingToken   String?      @unique
  pairingExpires DateTime?
  status         DeviceStatus @default(PENDING)
  lastSeenAt     DateTime?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

