# Android release signing config.
#
# 1. Copy this file to `keystore.properties` (repo root or android/ — both are
#    picked up by android/app/build.gradle). NEVER commit the real file.
# 2. Generate a keystore if you don't have one:
#      keytool -genkeypair -v -keystore android/app/project-z-release.keystore ^
#        -alias project-z -keyalg RSA -keysize 2048 -validity 10000
# 3. Fill in the values below.
#
# storeFile is resolved relative to android/app/ (or use an absolute path).
storeFile=project-z-release.keystore
keyAlias=project-z
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
