  "scripts": {
    "dev": "next dev",
    "build": "node scripts/vercel-build.mjs",
    "build:local": "npx prisma generate && npx next build",
    "validate:env": "node scripts/validate-production-env.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:e2e": "playwright test",
    "verify:shop": "tsx scripts/verify-shop-flows.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "node -e \"if(!process.env.VERCEL){require('child_process').execSync('npx prisma generate',{stdio:'inherit'})}\""
  },
